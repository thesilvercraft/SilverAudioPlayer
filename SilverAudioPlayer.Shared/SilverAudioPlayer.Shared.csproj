<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../SilverAudioPlayer.targets"/>

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release</Configurations>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Title>SilverAudioPlayer's Shared code</Title>
        <Product>SilverAudioPlayer</Product>
        <Description>Code shared between all SilverAudioPlayer modules</Description>
        <RepositoryUrl>https://gitlab.com/silvercraft/SilverAudioPlayer</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://gitlab.com/silvercraft/SilverAudioPlayer/tree/master/SilverAudioPlayer.Shared</PackageProjectUrl>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <IncludeSymbols>True</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <LangVersion>11</LangVersion>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="ReactiveUI" Version="19.5.1" />
        <PackageReference Include="Serilog" Version="3.1.1" />
        <PackageReference Include="SilverCraft.SilverConfig" Version="1.0.3"/>
        <PackageReference Include="System.Composition" Version="7.0.0" />
        <PackageReference Include="Opportunity.LrcParser" Version="1.0.4"/>
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SilverCraft.Ekorensis\SilverCraft.Ekorensis.csproj"/>
        <ProjectReference Include="..\SilverMagicBytes\SilverMagicBytes.csproj"/>
    </ItemGroup>


    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
