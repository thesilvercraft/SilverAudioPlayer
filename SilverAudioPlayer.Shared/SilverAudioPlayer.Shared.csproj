<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../SilverAudioPlayer.targets" />

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release</Configurations>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Title>SilverAudioPlayer's Shared code</Title>
        <Product>SilverAudioPlayer</Product>
        <Description>Code shared between all SilverAudioPlayer modules</Description>
        <RepositoryUrl>https://github.com/thesilvercraft/SilverAudioPlayer</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/thesilvercraft/SilverAudioPlayer/tree/master/SilverAudioPlayer.Shared</PackageProjectUrl>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <IncludeSymbols>True</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <LangVersion>11</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="ReactiveUI" Version="19.4.1" />
        <PackageReference Include="Serilog" Version="3.0.2-dev-02044" />
        <PackageReference Include="SilverCraft.SilverConfig" Version="1.0.3" />
        <PackageReference Include="System.Composition" Version="8.0.0-preview.6.23329.7" />
        <PackageReference Include="Opportunity.LrcParser" Version="1.0.4" />
        
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SilverMagicBytes\SilverMagicBytes.csproj" />
    </ItemGroup>


    <ItemGroup>
      <Reference Include="Serilog">
        <HintPath>..\..\..\..\..\..\home\silver\.nuget\packages\serilog\3.0.2-dev-02044\lib\net6.0\Serilog.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>
