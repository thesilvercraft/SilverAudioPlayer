<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		 xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SilverAudioPlayer.Any.Sync.MainWindow"
        Title="Sync"
        >
	<Grid RowDefinitions="25,70,*, 30" Margin="5" Name="MainGrid">
		<TextBlock Grid.Row="0" Text="{Binding Title}" Margin="5" />
		<Grid Grid.Row="1" ColumnDefinitions="*,*,150,100,100,100"  Margin="5"  >
			<ComboBox Grid.Column="0"  Name="DeviceBox" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionChanged="DeviceBox_OnSelectionChanged"></ComboBox>
			<TextBox Grid.Column="1" Name="LocationBox" TextChanged="LocationBox_OnTextChanged" />
			<ComboBox Grid.Column="2" Name="ExtensionBox" SelectedIndex="0" VerticalAlignment="Stretch">
				<ComboBoxItem Content="MP3" Tag=".mp3" />
				<ComboBoxItem Content="FLAC" Tag=".flac" />
				<ComboBoxItem Content="WAV" Tag=".wav" />
				<ComboBoxItem Content="Original (copy)" Tag="copy" />
			</ComboBox>
			<Button Grid.Column="3" Click="Button_OnClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">Refresh</Button>
			<Button Grid.Column="4" Click="Sync_OnClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">Sync</Button>
			<CheckBox Grid.Column="5" Name="ScrollToBottom">Scroll to bottom</CheckBox>
		</Grid>
		<AvaloniaEdit:TextEditor Grid.Row="2" IsReadOnly="True" Name="TextBox"
						 ShowLineNumbers="True"
						 FontFamily="Cascadia Code,Consolas,Menlo,Monospace"/>
		<ProgressBar Grid.Row="3" Name="ProgressBar" VerticalAlignment="Stretch"></ProgressBar>
	</Grid>
</Window>
