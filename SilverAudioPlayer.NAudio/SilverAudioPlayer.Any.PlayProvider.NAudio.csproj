<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../SilverAudioPlayer.targets" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release</Configurations>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <DefineConstants>$(DefineConstants);FFmpeg</DefineConstants>
        <AssemblyName>SilverAudioPlayer.Any.PlayProvider.NAudio</AssemblyName>
        <RootNamespace>SilverAudioPlayer.Any.PlayProvider.NAudio</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="NAudioLogo.png" />
        <None Remove="cscore.svg" />

    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="cscore.svg" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Silver.Composition\Silver.Composition.csproj" />
        <ProjectReference Include="..\SilverAudioPlayer.Shared\SilverAudioPlayer.Shared.csproj" />
        <PackageReference Include="SilverCraft.CSCore" Version="0.1.11" />
        <PackageReference Include="SilverCraft.CSCore.PortAudio" Version="0.1.11" />
        <PackageReference Include="SilverCraft.CSCore.SndFile" Version="0.1.8" />
        <PackageReference Include="SilverCraft.CSCore.OpenMPT" Version="0.1.8" />
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
        <PackageReference Include="NLayer.NAudioSupport" Version="1.4.0" />
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
        <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" Condition="$(DefineConstants.Contains('FFmpeg'))" />
    </ItemGroup>


</Project>
