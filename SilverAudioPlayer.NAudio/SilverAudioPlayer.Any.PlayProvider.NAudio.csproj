<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../SilverAudioPlayer.targets" />

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release</Configurations>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <!-- Disable CSCore integration, makes linux not have any output, disables ffmpeg, openmpt, sndfile   -->
        <DefineConstants>$(DefineConstants);CSCore</DefineConstants> 
        <!-- ffmpeg, requires cscore -->
        <DefineConstants>$(DefineConstants);FFmpeg</DefineConstants>
        <AssemblyName>SilverAudioPlayer.Any.PlayProvider.NAudio</AssemblyName>
        <RootNamespace>SilverAudioPlayer.Any.PlayProvider.NAudio</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="NAudioLogo.png" />
        <None Remove="cscore.svg" />

    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="NAudioLogo.png" Condition="! $(DefineConstants.Contains('CSCore'))" />
        <EmbeddedResource Include="cscore.svg" Condition="$(DefineConstants.Contains('CSCore'))" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Silver.Composition\Silver.Composition.csproj" />
        <ProjectReference Include="..\SilverAudioPlayer.Shared\SilverAudioPlayer.Shared.csproj" />
        <PackageReference Include="SilverCraft.CSCore" Version="0.1.0" Condition=" $(DefineConstants.Contains('CSCore'))" />
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
        <PackageReference Include="NLayer.NAudioSupport" Version="1.4.0" />
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
        <PackageReference Include="SilverCraft.CSCore.SndFile" Version="0.1.0" Condition=" $(DefineConstants.Contains('CSCore'))" />
        <PackageReference Include="SilverCraft.OpenMPT" Version="0.1.0"  Condition=" $(DefineConstants.Contains('CSCore'))" />
        <PackageReference Include="SilverCraft.CSCore.PortAudio" Version="0.1.0" Condition=" $(DefineConstants.Contains('CSCore'))" />
        <PackageReference Include="FFmpeg.AutoGen" Version="7.0.0" Condition="$(DefineConstants.Contains('FFmpeg'))" />
    </ItemGroup>


</Project>
