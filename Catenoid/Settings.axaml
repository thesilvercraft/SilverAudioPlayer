<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
        x:Class="Catenoid.Settings"
        Title="Settings"
        ExtendClientAreaToDecorationsHint="True"
		Icon="/icon.ico">
	<Grid RowDefinitions="25,*" Name="MainGrid">
		<TextBlock Grid.Row="0" Text="Settings"/>
	<ScrollViewer Grid.Row="1">
		<Grid RowDefinitions="200,30,30,*,*,36,*" ColumnDefinitions="*,*">
			<Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="200,*,80" RowDefinitions="*,*,*" Margin="5" >
				<SelectableTextBlock Grid.Column="1" Grid.Row="0" VerticalAlignment="Bottom" Grid.RowSpan="2" Text="{Binding ProductName}" FontSize="75" Margin="5" />
				<SelectableTextBlock Grid.Column="1"  Grid.Row="2" Text="{Binding ProductDescription}" FontSize="35" Margin="15,5,5,5" />
				<Button Name="ProductIconButton" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Click="ProductIconClick" Width="200"
				        Height="200">
					<Image Name="ProductIconImage" Source="{Binding ProductIcon}" Width="190" Height="190" VerticalAlignment="Center"
					       HorizontalAlignment="Center" />
				</Button>
				<Button Grid.Row="0" Grid.Column="2" Click="LicenseInfo">License</Button>
			</Grid>
			
			<Button Grid.Row="1" Grid.Column="0" Click="RegisterClick">Add or remove file associations</Button>
			<Button Grid.Row="2" Click="ToggleTransparency" Grid.Column="1">Toggle transparency</Button>
			<TextBox Name="TransparencyText" Grid.Row="2" Grid.Column="0" />
			<Expander Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" >
    			<Expander.Header>
        		<Label>Colours</Label>
   			    </Expander.Header>
    			<Grid RowDefinitions="*,*,*" ColumnDefinitions="150,*">
        			<TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Window background</TextBlock>
					<AutoCompleteBox Grid.Row="0" Grid.Column="1" Name="ColorBox" ItemsSource="{Binding AutoSuggestColours}" Text="{Binding BackgroundColour}" />
					<TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Progress bar</TextBlock>
       				<AutoCompleteBox Grid.Row="1" Grid.Column="1" Name="ColorBoxPB" ItemsSource="{Binding AutoSuggestColours}" Text="{Binding ProgressBarColour}" />
        			<TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Lyrics</TextBlock>
       				<AutoCompleteBox Grid.Row="2" Grid.Column="1" Name="ColorBoxLRC" ItemsSource="{Binding AutoSuggestColours}" Text="{Binding LyricsColour}" />
				</Grid>
			</Expander>
			<Expander Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" >
				<Expander.Header>
					<Label>Autosave</Label>
				</Expander.Header>
				<Grid RowDefinitions="*,*,*" ColumnDefinitions="150,*">
					<TextBlock Grid.Row="0" Grid.Column="0" Text="Autosave on exit and load on startup" VerticalAlignment="Center"/>
					<CheckBox Grid.Row="0" Grid.Column="1"  Name="AutoSaveCheckBox" IsChecked="{Binding Config.AutoSave}"/>
					<TextBlock Grid.Row="1" Grid.Column="0" Text="Autosave interval (seconds)" VerticalAlignment="Center"/>
					<NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Config.AutoSaveInterval}" Minimum="0" Maximum="99999"/>
				</Grid>
			</Expander>
		
			<TextBlock Grid.Row="5" Grid.Column="0" Text="Plugins:" FontSize="25" Margin="5" />
			<ListBox Name="CapBox" ItemsSource="{Binding Items}" Background="Transparent" Grid.Row="6"
			         DoubleTapped="ElementDoubleTapped" Grid.ColumnSpan="2" Grid.Column="0">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid RowDefinitions="*,*,*" ColumnDefinitions="95,*">
							<StackPanel Grid.Column="1">
								<SelectableTextBlock Text="{Binding Name}" FontSize="25" Margin="5" />
								<SelectableTextBlock Text="{Binding Description}" FontSize="12" Margin="5" />
								<SelectableTextBlock Text="{Binding Version}" FontSize="10" Margin="5" />
							</StackPanel>
							<Image Source="{Binding Icon}" Grid.Column="0" />
							<StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
								<Button IsVisible="{Binding Configurable}" Click="ConfigureClick">🔧Configure</Button>
								<Button IsVisible="{Binding IsAskingMemoryProvider}" Click="OpenConfigFileClick">🔧Open Config file</Button>
								<Button IsVisible="{Binding IsPlayStreamProvider}" Click="PlayProviderClick">Use</Button>
								<Button IsVisible="{Binding IsSyncPlugin}" Click="PlayProviderClick">Sync</Button>
								<CheckBox IsVisible="{Binding IsMusicStatusInterface}" IsCheckedChanged="EnableMSI" IsChecked="{Binding Item.IsStarted,Mode=OneWay}"/>
							</StackPanel>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>
	</ScrollViewer>
	</Grid>
</Window>