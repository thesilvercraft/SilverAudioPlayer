<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Catenoid.PlaylistWindow"
        Title="PlaylistWindow">
        <Grid Name="MainGrid" RowDefinitions="25,*, 50" Margin="5" DoubleTapped="MainGrid_OnDoubleTapped">
                <TextBlock Text="Playlist managment" Margin="5" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Playlists}" SelectionMode="Multiple" Selection="{Binding Selection}"  >
                        <ListBox.ContextMenu>
                                <ContextMenu>
                                        <MenuItem Header="Delete Selected" Click="DeleteSelected" />
                                </ContextMenu>
                        </ListBox.ContextMenu>
                </ListBox>
                <Grid Grid.Row="2" ColumnDefinitions="*, 100">
                        <TextBox Name="PlaylistFileName"></TextBox>
                        <Button Grid.Column="1">Save</Button>
                </Grid>
        </Grid>
</Window>
