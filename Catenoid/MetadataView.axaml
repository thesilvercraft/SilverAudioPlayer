<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:catenoid="clr-namespace:Catenoid"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Catenoid.MetadataView"
        Title="Metadata" Icon="/icon.ico">
    <Design.DataContext>
        <catenoid:MetadataViewDataContext />
    </Design.DataContext>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Padding" Value="5,10,5,10" />
        </Style>
    </Window.Styles>
    <Grid Margin="5 30 5 5">
        <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="*,256">
                <TreeView Name="mainTreeView" ItemsSource="{Binding ValuePairs}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding SubFields}">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{Binding FieldName}"
                                           MaxWidth="300" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding FieldName}" />
                                <TextBox Grid.Column="1" Text="{Binding FieldValue}"
                                         IsReadOnly="True" Margin="5,0,0,0" />
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <Image Grid.Column="1" Name="IMG" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Source="{Binding Bitmaps[0]}"
                       Width="256" Height="256" Tapped="IMG_DoubleTapped" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>