<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../SilverAudioPlayer.targets" />

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="LinuxPlatformHelper.svg" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="LinuxPlatformHelper.svg" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SilverAudioPlayer.Shared\SilverAudioPlayer.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Tmds.DBus" Version="0.16.0" />
        <PackageReference Include="Tmds.DBus.SourceGenerator" Version="0.0.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
