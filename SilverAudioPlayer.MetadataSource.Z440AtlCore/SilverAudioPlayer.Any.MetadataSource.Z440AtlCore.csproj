<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../SilverAudioPlayer.targets" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release</Configurations>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="ZATLMetadata.png" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="ZATLMetadata.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Composition" Version="10.0.0" />
        <PackageReference Include="z440.atl.core" Version="7.16.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SilverAudioPlayer.Shared\SilverAudioPlayer.Shared.csproj" />
    </ItemGroup>

   

</Project>
