<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../SilverAudioPlayer.targets" />
    <Import Project="../SilverAudioPlayer.Avalonia.targets" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="icon.svg" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Jellyfin.Sdk" Version="2025.10.21" />
        <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.79.2" />
    </ItemGroup>
    <ItemGroup>
        <TrimmableAssembly Include="Avalonia.Themes.Fluent" />
        <TrimmableAssembly Include="Avalonia.Themes.Default" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\SilverAudioPlayer.Shared\SilverAudioPlayer.Shared.csproj" />
    </ItemGroup>
    <ItemGroup>
        <UpToDateCheckInput Remove="Gui.axaml" />
    </ItemGroup>
    <ItemGroup>
        <UpToDateCheckInput Remove="AuthInfoWindow.axaml" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Include="icon.svg" />
    </ItemGroup>

</Project>
