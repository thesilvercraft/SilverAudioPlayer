<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../SilverAudioPlayer.targets"/>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Title>SilverCraft's simple UI abstraction layer</Title>
        <Product>SilverAudioPlayer</Product>
        <Description>SilverCraft's simple UI abstraction layer</Description>
        <RepositoryUrl>https://gitlab.com/silvercraft/SilverAudioPlayer</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://gitlab.com/silvercraft/SilverAudioPlayer/-/tree/master/SilverCraft.Ekorensis</PackageProjectUrl>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <IncludeSymbols>True</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <LangVersion>12.0</LangVersion>
    </PropertyGroup>
</Project>
