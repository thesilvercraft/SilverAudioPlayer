<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SilverAudioPlayer.Any.MusicStatusInterface.LyricsSyncer.LyricsView"
        Title="LyricsView"
        ExtendClientAreaToDecorationsHint="True"
	   >
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="20" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="TextAlignment" Value="Center" />
		</Style>
		<Style Selector="StackPanel">
			<Setter Property="HorizontalAlignment" Value="Center" />
		</Style>
    </Window.Styles>
    <Grid Name="MainGrid" RowDefinitions="25,*" ColumnDefinitions="*,*" Margin="5">
        <ScrollViewer Name="sv" VerticalScrollBarVisibility="Visible" Grid.Row="1" />
		<TextBox Name="box" Grid.Column="1" Grid.Row="1"></TextBox>
    </Grid>
</Window>